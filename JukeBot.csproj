<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>None</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
      <None Include="Pages\**\*" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Resources\**\*" CopyToOutputDirectory="PreserveNewest" TargetPath="Pages\Root\Resources\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>