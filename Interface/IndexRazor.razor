@using JukeBot.Engine.Linkage
@using JukeBot.Engine.Music
@inject FrontEnd Link

<main class="widget">
  <div class="scroller" style="--scroller-image: url('@Background')">
    <div class="song-title-viewport">
    <p class="song-title">@Title</p>
    </div>
    <div class="song-artist-viewport">
    <p class="song-artist">@Artist</p>
    </div>
    <div class="song-image" style="@Cover"></div>
    <div class="insider"></div>
  </div>
</main>

@code {
  private string Title = "(No song loaded)";
  private string Artist = "--";
  private string Background = "/Resources/Start/golem.png";
  private string Cover = "background-image: url('../../Resources/Default/album.webp')";

  protected override void OnInitialized()
  {
    base.OnInitialized();

    Link.UpdateSongPresentation = SetSongPresentation;
    Link.MarkReady();
  }

  private void SetSongPresentation(SongPresentationInfo info)
  {
    _ = InvokeAsync(() =>
    {
      Title = info.Title;
      Artist = info.Artist;
      Cover = ImageStyleFromFile(info.Cover);
      Background = info.Background;
      StateHasChanged();
    });
  }

  private static string ImageStyleFromFile(string imagePath)
  {
    if (string.IsNullOrWhiteSpace(imagePath) || !File.Exists(imagePath))
      return $"background-image: url('../../Resources/Default/album.webp')";

    string extension = Path.GetExtension(imagePath).ToLowerInvariant();
    string mimeType = extension switch
    {
      ".jpg" or ".jpeg" => "image/jpeg",
      ".png" => "image/png",
      ".gif" => "image/gif",
      ".webp" => "image/webp",
      ".bmp" => "image/bmp",
      _ => null
    };

    if (mimeType is null) return $"background-image: url('../../Resources/Default/album.webp')";

    string imageData = Convert.ToBase64String(File.ReadAllBytes(imagePath));
    return $"background-image: url('data:{mimeType};base64,{imageData}')";
  }
}
